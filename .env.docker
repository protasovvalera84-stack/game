# ─────────────────────────────────────────────────────────────────────────────
# OpenGame Studio — Docker / offline environment template
#
# Copy to .env and edit as needed before running:
#   cp .env.docker .env
#   docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# Port that the web UI / API is served on (default 4000)
APP_PORT=4000

# Ollama model to pull and use for game generation.
# Options (by quality vs. speed):
#   qwen2.5-coder:7b   — fast,  ~4 GB, works on CPU
#   qwen2.5-coder:14b  — better, ~8 GB, GPU recommended
#   codellama:7b       — alternative, ~4 GB
OPENGAME_MODEL=qwen2.5-coder:7b

# ── Optional: image generation ─────────────────────────────────────────────
# Leave blank to generate text-only games (no AI-generated sprites).
# Requires a cloud API key.
OPENGAME_IMAGE_PROVIDER=
OPENGAME_IMAGE_API_KEY=
OPENGAME_IMAGE_MODEL=
