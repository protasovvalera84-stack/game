# =============================================================================
# OpenGame Studio — конфигурация
#
# БЫСТРЫЙ СТАРТ:
#   1. Скопируйте этот файл: cp .env.docker .env
#   2. Вставьте ваш бесплатный Groq ключ ниже (https://console.groq.com)
#   3. Запустите: docker compose up -d --build
#   4. Откройте: http://localhost:4000
# =============================================================================

# ── Порт веб-интерфейса ───────────────────────────────────────────────────────
APP_PORT=4000

# ── AI провайдер — Groq (БЕСПЛАТНО, быстро, не нужно скачивать модели) ────────
#
# Получить бесплатный ключ за 2 минуты: https://console.groq.com
# Войти через Google → API Keys → Create API key → скопировать gsk_...
#
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=ВСТАВЬТЕ_GROQ_КЛЮЧ_СЮДА
OPENAI_MODEL=llama-3.3-70b-versatile

# ── Альтернативы (раскомментируйте нужное) ───────────────────────────────────

# Google Gemini — бесплатно (ключ: https://aistudio.google.com)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIza...
# OPENAI_MODEL=gemini-2.0-flash

# Ollama — локально без интернета (модель скачается ~4 ГБ)
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5-coder:7b

# OpenAI — платно
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# DeepSeek — $5 кредиты при регистрации (https://platform.deepseek.com)
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-coder

# ── Генерация изображений (необязательно) ────────────────────────────────────
# Оставьте пустым — игры создаются без AI-изображений (работает быстрее)
OPENGAME_IMAGE_PROVIDER=
OPENGAME_IMAGE_API_KEY=
OPENGAME_IMAGE_MODEL=

# ── Ollama — только если используете локальный режим выше ────────────────────
OPENGAME_MODEL=qwen2.5-coder:7b
